# AI / LLM Configuration
# Ollama runs locally by default at http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=

# Linear Configuration
# Team Key is PRA (Pranav Gaikwad)
LINEAR_API_KEY=lin_api_your_key_here
LINEAR_TEAM_ID=PRA

# Slack Configuration
# Bot token starting with xoxb-
SLACK_BOT_TOKEN=xoxb-your_token_here

# GitHub Configuration
# Classic PAT with 'repo' scope
GITHUB_TOKEN=ghp_your_token_here
GITHUB_DEFAULT_REPO=owner/repo_name

# App Settings
# Set to 'true' to execute real API calls, or 'false' to use the realistic Virtual Sandbox
LIVE_API_MODE=false
DATABASE_PATH=data/incidents.db
